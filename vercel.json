{
  "version": 2,
  "builds": [
    {
      "src": "paec-backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "paec-backend/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1"
    },
    {
      "src": "/(.*)\\.(js|css|png|jpg|svg|ico|woff2?|ttf|eot|json|map)$",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "DB_HOST": "mysql-24c4e904-anfalramzan548-cc66.j.aivencloud.com",
    "DB_PORT": "28080",
    "DB_USER": "avnadmin",
    "DB_PASSWORD": "AVNS_H6sUyjUqjeTtlMLKjU3",
    "DB_NAME": "defaultdb",
    "JWT_SECRET": "your-super-secret-key-2024",
    "NODE_ENV": "production"
  }
}